#!/bin/sh
# TRIMUI Model S / Powkiddy A66 Official Updater & Instant Launcher
# Triggered automatically when selected via TRIMUI "FILE" menu

# 1. Kill stock update UI to take over the display framebuffer
killall updateui
killall keymon

SD_ROOT="/mnt/SDCARD"
INSTALL_DIR="$SD_ROOT/Apps/kurui"
UPDATE_DIR="$(dirname "$0")"

# 2. Prepare target directory (Case-sensitive Apps)
mkdir -p "$INSTALL_DIR"

# 3. Copy launcher binary
SOURCE_BIN=""
if [ -f "$UPDATE_DIR/kurui" ]; then
    SOURCE_BIN="$UPDATE_DIR/kurui"
elif [ -f "$UPDATE_DIR/Apps/kurui/kurui" ]; then
    SOURCE_BIN="$UPDATE_DIR/Apps/kurui/kurui"
elif [ -f "$UPDATE_DIR/apps/kurui/kurui" ]; then
    SOURCE_BIN="$UPDATE_DIR/apps/kurui/kurui"
fi

if [ -n "$SOURCE_BIN" ] && [ -s "$SOURCE_BIN" ]; then
    cp "$SOURCE_BIN" "$INSTALL_DIR/kurui"
    chmod +x "$INSTALL_DIR/kurui"
fi

# 4. Install startup boot hook for subsequent power-ons
if [ -f "$UPDATE_DIR/trimui_init.sh" ]; then
    cp "$UPDATE_DIR/trimui_init.sh" "$SD_ROOT/trimui_init.sh"
    chmod +x "$SD_ROOT/trimui_init.sh"
fi

# 5. Clean up installer zip triggers
rm -f "$0" "$SD_ROOT/updater" "$SD_ROOT/update.sh"
sync

# 6. Execute KURUI instantly on the display!
export LD_LIBRARY_PATH="$INSTALL_DIR:$SD_ROOT/lib:/usr/lib:/usr/trimui/lib:$LD_LIBRARY_PATH"
cd "$INSTALL_DIR"

if [ -f "./kurui" ]; then
    ./kurui > "$SD_ROOT/kurui.log" 2>&1
fi

# Fallback to MainUI if kurui exits
if [ -f "/usr/trimui/bin/MainUI" ]; then
    exec /usr/trimui/bin/MainUI
fi
